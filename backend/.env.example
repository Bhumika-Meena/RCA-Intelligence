# Groq API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Neon Hosted PostgreSQL Database
# Format: postgresql+psycopg2://<user>:<password>@<ep-xyz.region.aws.neon.tech>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-cool-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
