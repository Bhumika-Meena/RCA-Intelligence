# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Supported active models on Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Neon Hosted PostgreSQL Database
# Format: postgresql+psycopg2://<user>:<password>@<ep-xyz.region.aws.neon.tech>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-cool-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
